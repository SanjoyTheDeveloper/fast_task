# ==============================================================================
# FastTask Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Supabase PostgreSQL for Prisma)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction Pooler (Port 6543) - Used for Prisma Client queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Session Mode Pooler (Port 5432) - Required for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js / NextAuth)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random secret (e.g. run: openssl rand -base64 33)
AUTH_SECRET="your-super-secret-auth-key-min-32-chars-long"
NEXTAUTH_SECRET="your-super-secret-auth-key-min-32-chars-long"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. Application URLs
# ------------------------------------------------------------------------------
# In development: http://localhost:3000
# In production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Email Configuration (Choose either Resend OR Gmail SMTP)
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended for production)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="FastTask <onboarding@resend.dev>"

# Option B: Gmail SMTP / Nodemailer (App Password, not your regular password)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-gmail-app-password"

# ------------------------------------------------------------------------------
# 5. Supabase Client Configuration (Frontend & Middleware)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
