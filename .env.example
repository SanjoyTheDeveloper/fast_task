# PostgreSQL Database Connection URL (Prisma)
# Example for local PostgreSQL: postgresql://username:password@localhost:5432/fast_task?schema=public
# Example for Neon/Supabase: postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fast_task?schema=public"

# Secret key for JWT session cookies
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars-long"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
